{
  "name": "dsh-notes",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "DSH 笔记工作区:右侧栏一个独立「笔记」区域(可收起的笔记树 + CodeMirror 6 编辑器),纯 Markdown + 薄索引,按工作区组织",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynaMyhome/dsh-notes.git"
  },
  "homepage": "https://github.com/DynaMyhome/dsh-notes",
  "bugs": {
    "url": "https://github.com/DynaMyhome/dsh-notes/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "setup": "npm install --prefix scripts --no-audit --no-fund",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
